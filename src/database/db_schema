-- asignatura
CREATE TABLE IF NOT EXISTS public.career (
    id BIGSERIAL PRIMARY KEY,
    code VARCHAR(20) NOT NULL UNIQUE,
    name VARCHAR(100) NOT NULL
);

-- semestre
CREATE TABLE IF NOT EXISTS public.semester (
    id BIGSERIAL PRIMARY KEY,
    year INTEGER NOT NULL,
    period VARCHAR(10) NOT NULL,
    start_date DATE NOT NULL,
    end_date DATE NOT NULL,
    grade_start_date DATE NOT NULL,
    grade_end_date DATE NOT NULL,
    status VARCHAR(20) DEFAULT 'PLANNED'
        CHECK (status IN ('PLANNED', 'IN_PROGRESS', 'CLOSED'))
);

-- usuario (no usar user por precaución)
CREATE TABLE IF NOT EXISTS public.usuario (
    id BIGSERIAL PRIMARY KEY,
    rut VARCHAR(12) NOT NULL UNIQUE,
    email VARCHAR(100) NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    rol VARCHAR(20) NOT NULL CHECK (rol IN ('STUDENT', 'PROFESSOR', 'ADMIN'))
);

-- carrera
CREATE TABLE IF NOT EXISTS public.subject (
    id BIGSERIAL PRIMARY KEY,
    code VARCHAR(20) NOT NULL UNIQUE,
    name VARCHAR(100) NOT NULL,
    credits INTEGER NOT NULL,
    career_id BIGINT REFERENCES career(id)
);

-- seccion
CREATE TABLE IF NOT EXISTS public.section (
    id BIGSERIAL PRIMARY KEY,
    subject_id BIGINT REFERENCES subject(id),
    professor_id BIGINT,
    semester_id BIGINT REFERENCES semester(id),
    total_seats INTEGER NOT NULL,
    available_seats INTEGER NOT NULL
);

-- prerequisito
CREATE TABLE IF NOT EXISTS public.prerequisite (
    subject_id BIGINT NOT NULL REFERENCES subject(id),
    prerequisite_subject_id BIGINT NOT NULL REFERENCES subject(id),
    PRIMARY KEY (subject_id, prerequisite_subject_id)
);

-- estudiante
CREATE TABLE IF NOT EXISTS public.student (
    id BIGSERIAL PRIMARY KEY,
    usuario_id BIGINT NOT NULL REFERENCES usuario(id),
    enrollment_number VARCHAR(20) NOT NULL UNIQUE,
    first_name VARCHAR(100) NOT NULL,
    last_name VARCHAR(100) NOT NULL,
    academic_status VARCHAR(20) NOT NULL DEFAULT 'ACTIVE'
        CHECK (academic_status IN ('ACTIVE', 'BLOCKED', 'GRADUATED'))
);

-- inscripcion
CREATE TABLE IF NOT EXISTS public.enrollment (
    id BIGSERIAL PRIMARY KEY,
    student_id BIGINT NOT NULL REFERENCES student(id),
    section_id BIGINT NOT NULL REFERENCES section(id),
    enrollment_date DATE NOT NULL DEFAULT CURRENT_DATE,
    status VARCHAR(20) NOT NULL DEFAULT 'ACTIVE'
        CHECK (status IN ('ACTIVE', 'CANCELLED', 'COMPLETED'))
);

-- notas
CREATE TABLE IF NOT EXISTS public.grade (
    id BIGSERIAL PRIMARY KEY,
    enrollment_id BIGINT NOT NULL REFERENCES enrollment(id),
    value NUMERIC(4,2) NOT NULL CHECK (value >= 1.0 AND value <= 7.0),
    entry_date DATE NOT NULL DEFAULT CURRENT_DATE
);

--  profesor
CREATE TABLE IF NOT EXISTS public.professor (
    id BIGSERIAL PRIMARY KEY,
    usuario_id BIGINT NOT NULL REFERENCES usuario(id),
    first_name VARCHAR(100) NOT NULL,
    last_name VARCHAR(100) NOT NULL,
    department VARCHAR(100) NOT NULL
);

-- auditoria
CREATE TABLE IF NOT EXISTS public.audit (
    id BIGSERIAL PRIMARY KEY,
    affected_table VARCHAR(50) NOT NULL,
    operation VARCHAR(10) NOT NULL,
    usuario_rut VARCHAR(12) NOT NULL,
    operation_date TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    old_data JSONB,
    new_data JSONB
);

-- TRIGGER 1
CREATE OR REPLACE FUNCTION fn_check_prerequisites()
RETURNS TRIGGER AS $$
DECLARE
    v_not_approved INTEGER;
    v_subject_id BIGINT;
BEGIN
    -- Primero obtenemos la asignatura de la sección que se quiere inscribir
    SELECT subject_id INTO v_subject_id
    FROM section
    WHERE id = NEW.section_id;

    -- Contamos prerequisitos no aprobados para esa asignatura
    SELECT COUNT(*)
    INTO v_not_approved
    FROM prerequisite p
    WHERE p.subject_id = v_subject_id
    AND NOT EXISTS (
        SELECT 1
        FROM enrollment e
        INNER JOIN grade g ON g.enrollment_id = e.id
        INNER JOIN section sec ON sec.id = e.section_id
        WHERE e.student_id = NEW.student_id
        AND sec.subject_id = p.prerequisite_subject_id
        AND g.value >= 4.0
    );

    -- Si hay al menos uno no aprobado, bloquea
    IF v_not_approved > 0 THEN
        RAISE EXCEPTION 'El estudiante no ha aprobado todos los prerequisitos necesarios';
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Vista Materializada (Tasa de Reprobación Histórica)
-- Esta consulta une notas, inscripciones y secciones para calcular el % de reprobación.
CREATE MATERIALIZED VIEW IF NOT EXISTS public.mv_failure_rate AS
SELECT
    sub.id AS subject_id,
    sub.code AS subject_code,
    sub.name AS subject_name,
    COUNT(g.id) AS total_grades,
    SUM(CASE WHEN g.value < 4.0 THEN 1 ELSE 0 END) AS failed_grades,
    CASE
        WHEN COUNT(g.id) = 0 THEN 0.0
        ELSE ROUND((SUM(CASE WHEN g.value < 4.0 THEN 1 ELSE 0 END)::NUMERIC / COUNT(g.id)) * 100, 2)
    END AS failure_percentage
FROM
    subject sub
LEFT JOIN section sec ON sub.id = sec.subject_id
LEFT JOIN enrollment e ON sec.id = e.section_id
LEFT JOIN grade g ON e.id = g.enrollment_id
GROUP BY
    sub.id, sub.code, sub.name;

-- Refrescar la Vista Materializada
CREATE OR REPLACE FUNCTION refresh_mv_failure_rate()
RETURNS void AS $$
BEGIN
    REFRESH MATERIALIZED VIEW public.mv_failure_rate;
END;
$$ LANGUAGE plpgsql;