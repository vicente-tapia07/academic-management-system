CREATE INDEX IF NOT EXISTS idx_subject_code ON public.subject(code);
CREATE INDEX IF NOT EXISTS idx_section_semester ON public.section(semester_id);

-- =============================================
-- FUNCIÓN: check calendario notas
-- =============================================
CREATE OR REPLACE FUNCTION fn_check_calendario_notas()
RETURNS TRIGGER AS $$
DECLARE
    v_grade_start DATE;
    v_grade_end DATE;
    v_section_id BIGINT;
BEGIN
    SELECT e.section_id
    INTO v_section_id
    FROM enrollment e
    WHERE e.id = NEW.enrollment_id;

    IF v_section_id IS NULL THEN
        RAISE EXCEPTION 'No existe la inscripción asociada a la nota';
    END IF;

    SELECT s.grade_start_date, s.grade_end_date
    INTO v_grade_start, v_grade_end
    FROM semester s
    INNER JOIN section sec ON sec.semester_id = s.id
    WHERE sec.id = v_section_id;

    IF v_grade_start IS NULL OR v_grade_end IS NULL THEN
        RAISE EXCEPTION 'No se pudo determinar el calendario académico de la sección';
    END IF;

    IF NEW.entry_date < v_grade_start OR NEW.entry_date > v_grade_end THEN
        RAISE EXCEPTION 'No se pueden ingresar notas fuera del calendario académico';
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- =============================================
-- TRIGGER 2: check calendario notas
-- =============================================
CREATE TRIGGER trg_check_calendario_notas
BEFORE INSERT OR UPDATE ON public.grade
FOR EACH ROW
EXECUTE FUNCTION public.fn_check_calendario_notas();

-- =============================================
-- STORED PROCEDURE 1: cierre de semestre
-- =============================================
CREATE OR REPLACE PROCEDURE public.sp_close_semester(IN p_semester_id bigint)
LANGUAGE plpgsql
AS $procedure$
DECLARE
    v_student_id BIGINT;
    v_average NUMERIC;
BEGIN
    FOR v_student_id IN
        SELECT DISTINCT e.student_id
        FROM enrollment e
        JOIN section sec ON e.section_id = sec.id
        WHERE sec.semester_id = p_semester_id
    LOOP
        SELECT ROUND(
            SUM(g.value * sub.credits) / NULLIF(SUM(sub.credits), 0), 2
        )
        INTO v_average
        FROM grade g
        JOIN enrollment e ON g.enrollment_id = e.id
        JOIN section sec ON e.section_id = sec.id
        JOIN subject sub ON sec.subject_id = sub.id
        WHERE e.student_id = v_student_id
          AND sec.semester_id = p_semester_id;

        IF v_average IS NOT NULL AND v_average < 4.0 THEN
            UPDATE student
            SET academic_status = 'BLOCKED'
            WHERE id = v_student_id;
        END IF;
    END LOOP;

    UPDATE semester
    SET status = 'CLOSED'
    WHERE id = p_semester_id;

    RAISE NOTICE 'Semestre % cerrado correctamente', p_semester_id;
END;
$procedure$;

-- =============================================
-- STORED PROCEDURE 2: chequear prerequisitos
-- =============================================
CREATE OR REPLACE PROCEDURE sp_enroll_student(
    p_student_id BIGINT,
    p_section_id BIGINT
)
LANGUAGE plpgsql
AS $$
DECLARE
    -- Variable para guardar los cupos disponibles de la sección
    v_available_seats INTEGER;
BEGIN
    -- Paso 1: Verificamos cuántos cupos quedan en la sección
    SELECT available_seats INTO v_available_seats
    FROM section
    WHERE id = p_section_id;

    -- Paso 2: Si no hay cupos, lanzamos error
    IF v_available_seats <= 0 THEN
        RAISE EXCEPTION 'La sección no tiene cupos disponibles';
    END IF;

    -- Paso 3: Inscribimos al estudiante
    INSERT INTO enrollment (student_id, section_id)
    VALUES (p_student_id, p_section_id);

    -- Paso 4: Descontamos un cupo de la sección
    UPDATE section
    SET available_seats = available_seats - 1
    WHERE id = p_section_id;

END;
$$;

-- Vista Materializada (Tasa de Reprobación Histórica)
-- Esta consulta une notas, inscripciones y secciones para calcular el % de reprobación.
CREATE MATERIALIZED VIEW IF NOT EXISTS public.mv_failure_rate AS
SELECT
    sub.id AS subject_id,
    sub.code AS subject_code,
    sub.name AS subject_name,
    COUNT(g.id) AS total_grades,
    SUM(CASE WHEN g.value < 4.0 THEN 1 ELSE 0 END) AS failed_grades,
    CASE
        WHEN COUNT(g.id) = 0 THEN 0.0
        ELSE ROUND((SUM(CASE WHEN g.value < 4.0 THEN 1 ELSE 0 END)::NUMERIC / COUNT(g.id)) * 100, 2)
    END AS failure_percentage
FROM
    subject sub
LEFT JOIN section sec ON sub.id = sec.subject_id
LEFT JOIN enrollment e ON sec.id = e.section_id
LEFT JOIN grade g ON e.id = g.enrollment_id
GROUP BY
    sub.id, sub.code, sub.name;

-- Refrescar la Vista Materializada
CREATE OR REPLACE FUNCTION refresh_mv_failure_rate()
RETURNS void AS $$
BEGIN
    REFRESH MATERIALIZED VIEW public.mv_failure_rate;
END;
$$ LANGUAGE plpgsql;
